# ==========================================
# Email.Flow QA Handoff Automation Environment Config
# ==========================================

# Slack Bot Configuration
# Scopes needed: chat:write, chat:write.public, links:write
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0ANGFFEFS8

# Monday.com API Configuration
# API Token generated in Monday.com Developer / Admin section
MONDAY_API_TOKEN=your-monday-api-v2-token
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_VERSION=2023-10

# Board IDs to monitor (comma-separated)
# Default: Viewers Project Hub (4209532311), Creators Project Hub (4209567424)
WATCH_BOARDS=4209532311,4209567424

# Monday column ID used to store the Slack Thread TS for traceability
MONDAY_THREAD_TS_COLUMN=slack_thread_ts

# Google Drive / Workspace Provisioning
# Master QA Checklist Template Spreadsheet ID
MASTER_CHECKLIST_TEMPLATE_ID=1AQOaskr3VWWl7rCBzMr505uVXBjCBmQ96M_zn7QkJ6I
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_DRIVE_SHARE_DOMAIN=monks.com

# Polling and Storage
DEDUP_DB_PATH=email_flow_dedup.db
POLL_INTERVAL_SECONDS=60

# Gamma Deployment Tool URL Base
GAMMA_BASE_URL=https://gamma.corp.google.com/index.html#/campaign/{campaign_id}/home
